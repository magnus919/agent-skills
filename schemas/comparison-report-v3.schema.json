{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magnus919/agent-skills/schemas/comparison-report-v3.schema.json",
  "title": "Paired evaluation comparison report v3",
  "description": "Case-level comparison with separate execution, evidence, and semantic verdict states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "skill_name",
    "case_id",
    "candidate",
    "baseline",
    "aggregate_outcome",
    "paired_delta"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "report_id": {"type": "string", "format": "uuid"},
    "generated_at": {"type": "string", "format": "date-time"},
    "skill_name": {"type": "string", "minLength": 1},
    "comparison_mode": {
      "type": "string",
      "enum": ["skill_vs_no_skill", "pinned_skill_vs_skill"],
      "description": "Distinguishes the no-skill diagnostic from a comparison of two pinned skill snapshots."
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F])[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "candidate": {"$ref": "#/$defs/arm_result"},
    "baseline": {"$ref": "#/$defs/arm_result"},
    "aggregate_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_semantic_verdict", "baseline_semantic_verdict", "comparison_status"],
      "properties": {
        "candidate_semantic_verdict": {"$ref": "#/$defs/semantic_verdict"},
        "baseline_semantic_verdict": {"$ref": "#/$defs/semantic_verdict"},
        "comparison_status": {
          "type": "string",
          "enum": ["comparable", "insufficient_data", "insufficient_evidence"]
        }
      }
    },
    "paired_delta": {
      "type": "string",
      "enum": [
        "candidate_improvement",
        "candidate_regression",
        "both_pass",
        "both_fail",
        "insufficient_data",
        "insufficient_evidence"
      ]
    }
  },
  "$defs": {
    "semantic_verdict": {
      "type": "string",
      "enum": ["pass", "fail", "not_assessed"]
    },
    "arm_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "execution_status",
        "execution_success",
        "semantic_verdict",
        "evidence_complete",
        "assertion_count",
        "resolved_count",
        "passed",
        "infra_error",
        "pass_count",
        "fail_count",
        "manual_count",
        "assertions",
        "manifest"
      ],
      "properties": {
        "trial_id": {"type": "string"},
        "execution_status": {
          "type": "string",
          "enum": ["completed", "error", "timeout", "stopped"]
        },
        "execution_success": {"type": "boolean"},
        "semantic_verdict": {
          "$ref": "#/$defs/semantic_verdict"
        },
        "evidence_complete": {"type": "boolean"},
        "assertion_count": {"type": "integer", "minimum": 0},
        "resolved_count": {"type": "integer", "minimum": 0},
        "passed": {
          "type": "boolean",
          "description": "Compatibility field; true only when semantic_verdict is pass."
        },
        "infra_error": {"type": "boolean"},
        "pass_count": {"type": "integer", "minimum": 0},
        "fail_count": {"type": "integer", "minimum": 0},
        "manual_count": {"type": "integer", "minimum": 0},
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion", "verdict", "detail"],
            "properties": {
              "assertion": {"type": "string"},
              "verdict": {
                "type": "string",
                "enum": ["pass", "fail", "manual_review", "infra_error"]
              },
              "detail": {"type": "string"}
            }
          }
        },
        "manifest": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"semantic_verdict": {"const": "pass"}}},
          "then": {"properties": {"passed": {"const": true}}},
          "else": {"properties": {"passed": {"const": false}}}
        },
        {
          "if": {"properties": {"execution_status": {"const": "completed"}}},
          "then": {"properties": {"execution_success": {"const": true}}},
          "else": {"properties": {"execution_success": {"const": false}}}
        }
      ]
    }
  }
}
